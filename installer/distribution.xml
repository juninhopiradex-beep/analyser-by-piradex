<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>MIXSPACE by Piradex</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <allowed-os-versions>
        <os-version min="10.13"/>
    </allowed-os-versions>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.piradex.mixspace.plugins"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.piradex.mixspace.plugins" visible="false">
        <pkg-ref id="com.piradex.mixspace.plugins"/>
    </choice>
    <pkg-ref id="com.piradex.mixspace.plugins" version="__VERSAO__" onConclusion="none">mixspace-plugins.pkg</pkg-ref>
</installer-gui-script>
